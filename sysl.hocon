// Manifold — robust boolean operations on triangle meshes — bound for sysl.
//
// This is the block a consumer writes to reach it:
//
//     dependencies {
//       manifold { git = "github.com/sysl-lang/manifold", version = "0.1.1" }
//     }
//
// The coordinate names the package, `manifold`; the module a program imports is `sh.sysl.manifold`.

package {
  name    = "manifold"
  version = "0.1.1"

  // The compiler this was written and tested against.
  sysl = "0.8.3"
}

// **`heap`**: every Manifold object is C++ storage allocated by the library, and every copy-out is a
// `Buf`. **`posix`**: Manifold is a hosted C++ library with a thread pool (TBB) under it.
//
// **`pkg_config`** gives the library's include and link directories; `@link("manifoldc")` in `c/c.sysl`
// names the C wrapper beside it.
requires {
  heap  = true
  posix = true

  pkg_config {
    manifold = "Manifold 3.5 — `brew install manifold` on macOS"
  }
}
