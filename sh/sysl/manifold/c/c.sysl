// Manifold's C API (`manifold/manifoldc.h`, 3.5.4) as C reaches it: one declaration per C declaration,
// all 294 of them.
//
// **Nothing here is meant to be called by a program.** Every constructor takes caller storage
// (`void *mem`) and answers a pointer into it, every handle has to be destructed and freed by hand, and
// an enumeration is an `i32`. The module above this one, `sh.sysl.manifold`, turns each handle into a
// `&T` whose `Drop` deletes it, and is what an application imports.
//
// **Written by `sysl import-c` and then edited, in two ways, both forced by how Manifold is
// installed:**
//
// - **No `@include`, no `c const`, no `@assert` against the header.** Homebrew's `manifold.pc` is
//   written for C++ — its `Cflags` carry `-std=c++17` — and sysl hands a `.pc`'s `Cflags` to every C
//   compile of the package, `c const` probes included, which clang refuses for C (`invalid argument
//   '-std=c++17' not allowed with 'C'`). So this package compiles no C at all: `pkg_config` is used
//   for what it gets right, the `-L` to the library, and the layouts below are transcribed. The
//   records are all `f64`, pointers and `size_t`, and `tests.sysl` pins every size and offset to what
//   clang measured from `types.h`.
// - **The enumerations are written out** (`OP_ADD` and the rest, below). `import-c --follow` brought
//   the records of `types.h` across but not its `enum`s, so the eight functions taking one were not
//   generated; they are written by hand at the foot of this file, an enum crossing as C's `int`.

module sh.sysl.manifold.c

// `libmanifoldc` is the C wrapper; it depends on `libmanifold` (the C++ library) through its own
// `@rpath`, which the dylib's own `LC_RPATH` resolves, so it is the only library named here.
@link("manifoldc")

// Every handle: C++ objects placed in storage `alloc_*` made, released by `delete_*`.
opaque struct Manifold

opaque struct ManifoldVec

opaque struct CrossSection

opaque struct CrossSectionVec

opaque struct RayHitVec

opaque struct SimplePolygon

opaque struct Polygons

opaque struct MeshGL

opaque struct MeshGL64

opaque struct Box

opaque struct Rect

opaque struct Triangulation

opaque struct ExecutionContext

struct ManifoldPair
    first: *Manifold
    second: *Manifold

struct Vec2
    x: f64
    y: f64

struct Vec3
    x: f64
    y: f64
    z: f64

struct MeshGLOptions
    run_indices: *u32
    run_indices_length: usize
    run_original_ids: *u32
    run_original_ids_length: usize
    merge_from_vert: *u32
    merge_to_vert: *u32
    merge_verts_length: usize
    halfedge_tangents: *f32

struct MeshGL64Options
    run_indices: *u64
    run_indices_length: usize
    run_original_ids: *u32
    run_original_ids_length: usize
    merge_from_vert: *u64
    merge_to_vert: *u64
    merge_verts_length: usize
    halfedge_tangents: *f64

struct RayHit
    face_id: u64
    distance: f64
    position: Vec3
    normal: Vec3

// The enumerations of `types.h`. Each is a plain C `enum` numbered from 0, so it crosses as an `i32`.

// `ManifoldOpType`
val OP_ADD = 0
val OP_SUBTRACT = 1
val OP_INTERSECT = 2

// `ManifoldFillRule`
val FILL_RULE_EVEN_ODD = 0
val FILL_RULE_NON_ZERO = 1
val FILL_RULE_POSITIVE = 2
val FILL_RULE_NEGATIVE = 3

// `ManifoldJoinType`
val JOIN_TYPE_SQUARE = 0
val JOIN_TYPE_ROUND = 1
val JOIN_TYPE_MITER = 2
val JOIN_TYPE_BEVEL = 3

// `ManifoldError`, which `status` answers. The pleasant layer's `Status` is these in this order.
val NO_ERROR = 0
val CANCELLED = 14

